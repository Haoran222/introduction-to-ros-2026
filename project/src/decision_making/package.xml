<?xml version="1.0"?>
<package format="3">
  <name>decision_making</name>
  <version>0.1.0</version>
  <description>
    Decision-making stack for the Autonomous Driving project: a forward-hazard
    monitor over perception's depth point cloud, and a state machine that gates
    planning's trajectory for red lights, merging traffic, and emergency braking.
  </description>
  <maintainer email="haoranwang0222@gmail.com">Haoran Wang</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>planning</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <exec_depend>simulation</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
