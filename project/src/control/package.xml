<?xml version="1.0"?>
<package format="3">
  <name>control</name>
  <version>0.1.0</version>
  <description>
    Vehicle control for the Autonomous Driving project: a pure-pursuit + PID
    trajectory follower that turns decision_making's gated trajectory into
    throttle/brake/steering commands for the simulator.
  </description>
  <maintainer email="haoranwang0222@gmail.com">Haoran Wang</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>planning</depend>
  <depend>simulation</depend>

  <exec_depend>decision_making</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
